<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Alta de Materia</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">{{#subject}}Editar Materia{{/subject}}{{^subject}}Registrar Nueva Materia{{/subject}}</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="{{#subject}}/materia/update/{{subject.id}}{{/subject}}{{^subject}}/materia/new{{/subject}}" method="post" class="space-y-4">
            <div>
                <label for="nombre" class="block text-gray-700 text-sm font-medium mb-1">
                    Nombre: <span class="text-red-500">*</span>
                </label>
                <input type="text" id="nombre" name="nombre" required value="{{#subject}}{{subject.nombre}}{{/subject}}"
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
                       placeholder="Ej: Algoritmos y Estructuras de Datos">
            </div>

            <div>
                <label for="codigo" class="block text-gray-700 text-sm font-medium mb-1">
                    Código: <span class="text-red-500">*</span>
                </label>
                <input type="text" id="codigo" name="codigo" required value="{{#subject}}{{subject.codigo}}{{/subject}}"
                       class="w-full px-4 py-2 border {{#errorCodigo}}border-red-500{{/errorCodigo}}{{^errorCodigo}}border-gray-300{{/errorCodigo}} rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
                       placeholder="Ej: AED-101">
                {{#errorCodigo}}
                <p class="text-red-500 text-sm mt-1">{{errorCodigo}}</p>
                {{/errorCodigo}}
            </div>

            <div>
                <label for="id_careers" class="block text-gray-700 text-sm font-medium mb-1">
                    Carreras Asociadas: <span class="text-red-500">*</span>
                </label>
                <select id="id_careers" name="id_careers" multiple required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 h-32">
                    {{#careers}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{nombre}} ({{codigo}})</option>
                    {{/careers}}
                </select>
                <p class="text-xs text-gray-500 mt-1">Mantené presionado Ctrl (o Cmd) para seleccionar varias carreras.</p>
            </div>

            <div>
                <label for="duracion" class="block text-gray-700 text-sm font-medium mb-1">
                    Duración: <span class="text-red-500">*</span>
                </label>
                <select id="duracion" name="duracion" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                    <option value="Cuatrimestral" {{#isCuatrimestral}}selected{{/isCuatrimestral}}>1 Cuatrimestre (Cuatrimestral)</option>
                    <option value="Anual" {{#isAnual}}selected{{/isAnual}}>2 Cuatrimestres (Anual)</option>
                </select>
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2">
                    Guardar Materia
                </button>
                <a href="/dashboard"
                   class="flex-1 bg-gray-400 text-white py-2 px-4 rounded-md hover:bg-gray-500 text-center">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</body>
</html>
