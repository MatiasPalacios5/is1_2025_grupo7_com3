<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Alta de Estudiante</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Registrar Nuevo Estudiante</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/estudiante/new" method="post" class="space-y-4">
            <div>
                <label for="nombre" class="block text-gray-700 text-sm font-medium mb-1">Nombre: <span class="text-red-500">*</span></label>
                <input type="text" id="nombre" name="nombre" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label for="apellido" class="block text-gray-700 text-sm font-medium mb-1">Apellido: <span class="text-red-500">*</span></label>
                <input type="text" id="apellido" name="apellido" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label for="dni" class="block text-gray-700 text-sm font-medium mb-1">DNI: <span class="text-red-500">*</span></label>
                <input type="text" id="dni" name="dni" required
                       class="w-full px-4 py-2 border {{#errorDni}}border-red-500{{/errorDni}}{{^errorDni}}border-gray-300{{/errorDni}} rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                       placeholder="12345678">
                {{#errorDni}}
                <p class="text-red-500 text-sm mt-1">{{errorDni}}</p>
                {{/errorDni}}
            </div>

            <div>
                <label for="legajo" class="block text-gray-700 text-sm font-medium mb-1">Legajo: <span class="text-red-500">*</span></label>
                <input type="text" id="legajo" name="legajo" required
                       class="w-full px-4 py-2 border {{#errorLegajo}}border-red-500{{/errorLegajo}}{{^errorLegajo}}border-gray-300{{/errorLegajo}} rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                       placeholder="Ej: 12345">
                {{#errorLegajo}}
                <p class="text-red-500 text-sm mt-1">{{errorLegajo}}</p>
                {{/errorLegajo}}
            </div>

            <div>
                <label for="situacion" class="block text-gray-700 text-sm font-medium mb-1">Situación: <span class="text-red-500">*</span></label>
                <select id="situacion" name="situacion" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">Seleccionar...</option>
                    <option value="Ingresante">Ingresante</option>
                    <option value="Efectivo">Efectivo</option>
                </select>
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                    Guardar Estudiante
                </button>
                <a href="/dashboard"
                   class="flex-1 bg-gray-400 text-white py-2 px-4 rounded-md hover:bg-gray-500 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 text-center">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</body>
</html>
