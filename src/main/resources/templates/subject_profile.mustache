<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Perfil de Materia</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-8">
<div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-5xl mx-auto">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Perfil de Materia</h1>
        </div>

        <div class="bg-indigo-50 p-6 rounded-lg border border-indigo-100 mb-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="md:col-span-2 text-xl mb-2"><span class="font-bold text-indigo-900">{{nombre}}</span> <span class="text-gray-500 text-base">{{codigo}}</span></div>
                <div><span class="font-bold text-gray-700">Plan de Estudio:</span> {{planName}}</div>
                <div><span class="font-bold text-gray-700">Duración:</span> 
                    <span class="bg-indigo-200 text-indigo-800 text-xs px-2 py-1 rounded-full uppercase">{{duracion}}</span>
                </div>
                <div><span class="font-bold text-gray-700">Año de Dictado:</span> {{anoDictado}}</div>
                <div><span class="font-bold text-gray-700">Cuatrimestre:</span> {{cuatrimestreDictado}}</div>
                <div class="md:col-span-2"><span class="font-bold text-gray-700">Correlativas:</span> {{correlativas}}</div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Profesores -->
            <div>
                <h2 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2">Cuerpo Docente (Histórico)</h2>
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-100">
                            <th class="py-2 px-3 border-b font-semibold text-gray-700">Profesor</th>
                            <th class="py-2 px-3 border-b font-semibold text-gray-700">Período</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#profesores}}
                        <tr class="hover:bg-gray-50">
                            <td class="py-2 px-3 border-b">{{profeName}}</td>
                            <td class="py-2 px-3 border-b text-sm text-gray-600">{{periodo}}</td>
                        </tr>
                        {{/profesores}}
                        {{^profesores}}
                        <tr>
                            <td colspan="2" class="py-4 text-center text-gray-500">No hay profesores asignados.</td>
                        </tr>
                        {{/profesores}}
                    </tbody>
                </table>
            </div>

            <!-- Alumnos Aprobados -->
            <div>
                <h2 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2">Alumnos que Aprobaron</h2>
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-100">
                            <th class="py-2 px-3 border-b font-semibold text-gray-700">Estudiante</th>
                            <th class="py-2 px-3 border-b font-semibold text-gray-700">Fecha</th>
                            <th class="py-2 px-3 border-b font-semibold text-gray-700">Nota</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#alumnosAprobados}}
                        <tr class="hover:bg-gray-50">
                            <td class="py-2 px-3 border-b">{{alumnoName}}</td>
                            <td class="py-2 px-3 border-b text-sm text-gray-600">{{fecha}}</td>
                            <td class="py-2 px-3 border-b font-bold text-emerald-600">{{nota}}</td>
                        </tr>
                        {{/alumnosAprobados}}
                        {{^alumnosAprobados}}
                        <tr>
                            <td colspan="3" class="py-4 text-center text-gray-500">Aún no hay alumnos aprobados.</td>
                        </tr>
                        {{/alumnosAprobados}}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-8 flex gap-4">
            <a href="/materia/list" class="text-indigo-600 hover:underline">← Volver al listado</a>
            <a href="/dashboard" class="text-gray-600 hover:underline">Volver al dashboard</a>
        </div>
    </div>
</body>
</html>
