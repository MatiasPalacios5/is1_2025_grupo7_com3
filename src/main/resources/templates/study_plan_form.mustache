<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Alta/Edición de Plan de Estudio</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
<div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">{{#plan}}Editar Plan{{/plan}}{{^plan}}Nuevo Plan{{/plan}}</h1>

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="{{#plan}}/plan/update/{{plan.id}}{{/plan}}{{^plan}}/plan/new{{/plan}}" method="post" class="space-y-4">
            <div>
                <label for="year" class="block text-gray-700 text-sm font-medium mb-1">Año: <span class="text-red-500">*</span></label>
                <input type="number" id="year" name="year" value="{{#plan}}{{year}}{{/plan}}" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                       placeholder="Ej: 2024">
            </div>

            <div>
                <label for="resolution" class="block text-gray-700 text-sm font-medium mb-1">Resolución: <span class="text-red-500">*</span></label>
                <input type="text" id="resolution" name="resolution" value="{{#plan}}{{resolution}}{{/plan}}" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                       placeholder="Ej: RES-123/24">
            </div>

            <div>
                <label for="id_career" class="block text-gray-700 text-sm font-medium mb-1">Carrera: <span class="text-red-500">*</span></label>
                <select id="id_career" name="id_career" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">Seleccionar Carrera...</option>
                    {{#careers}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{nombre}}</option>
                    {{/careers}}
                </select>
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                    Guardar
                </button>
                <a href="/plan/list"
                   class="flex-1 bg-gray-400 text-white py-2 px-4 rounded-md hover:bg-gray-500 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 text-center">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</body>
</html>
