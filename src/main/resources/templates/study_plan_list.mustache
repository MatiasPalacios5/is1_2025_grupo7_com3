<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Listado de Planes de Estudio</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-8">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-4xl mx-auto">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Planes de Estudio</h1>
            <a href="/plan/create"
               class="bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition duration-300">
                Nuevo Plan
            </a>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-100">
                    <th class="py-3 px-4 border-b font-semibold text-gray-700">Año</th>
                    <th class="py-3 px-4 border-b font-semibold text-gray-700">Resolución</th>
                    <th class="py-3 px-4 border-b font-semibold text-gray-700">Carrera</th>
                    <th class="py-3 px-4 border-b font-semibold text-gray-700">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#plans}}
                <tr class="hover:bg-gray-50">
                    <td class="py-3 px-4 border-b">{{year}}</td>
                    <td class="py-3 px-4 border-b">{{resolution}}</td>
                    <td class="py-3 px-4 border-b">{{careerName}}</td>
                    <td class="py-3 px-4 border-b">
                        <a href="/plan/edit/{{id}}" class="bg-yellow-500 text-white py-1 px-3 rounded hover:bg-yellow-600 text-sm mr-2 inline-block">Editar</a>
                        <form action="/plan/delete/{{id}}" method="post" style="display:inline;">
                            <button type="submit"
                                    onclick="return confirm('¿Seguro que querés eliminar este plan?')"
                                    class="bg-red-500 text-white py-1 px-3 rounded hover:bg-red-600 text-sm">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
                {{/plans}}
                {{^plans}}
                <tr>
                    <td colspan="4" class="py-4 px-4 text-center text-gray-500">No hay planes registrados.</td>
                </tr>
                {{/plans}}
            </tbody>
        </table>

        <div class="mt-6">
            <a href="/dashboard" class="text-blue-600 hover:underline">← Volver al dashboard</a>
        </div>
    </div>
</body>
</html>
