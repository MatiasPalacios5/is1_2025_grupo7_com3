<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Listado de Carreras</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-8">
<div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-4xl mx-auto">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Listado de Carreras</h1>
            <a href="/carrera/create"
               class="bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 transition duration-300">
                Nueva Carrera
            </a>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-100">
                    <th class="py-3 px-4 border-b font-semibold text-gray-700">Código</th>
                    <th class="py-3 px-4 border-b font-semibold text-gray-700">Nombre</th>
                    <th class="py-3 px-4 border-b font-semibold text-gray-700">Duración (años)</th>
                    <th class="py-3 px-4 border-b font-semibold text-gray-700">Planes de Estudio</th>
                    <th class="py-3 px-4 border-b font-semibold text-gray-700">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#careers}}
                <tr class="hover:bg-gray-50">
                    <td class="py-3 px-4 border-b">{{codigo}}</td>
                    <td class="py-3 px-4 border-b">{{nombre}}</td>
                    <td class="py-3 px-4 border-b">{{duracion}}</td>
                    <td class="py-3 px-4 border-b text-sm text-gray-600">{{planes}}</td>
                    <td class="py-3 px-4 border-b">
                        <div class="flex items-center gap-2">
                            <a href="/carrera/edit/{{id}}" class="bg-blue-500 text-white p-2 rounded hover:bg-blue-600 transition shadow-sm" title="Editar">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.89 1.147l-3.111.831a.75.75 0 01-.921-.921l.83-3.11a4.5 4.5 0 011.147-1.892L16.862 4.487zM16.862 4.487L19.5 7.125" />
                                </svg>
                            </a>
                            <form action="/carrera/delete/{{id}}" method="post" class="m-0">
                                <button type="submit" title="Eliminar"
                                        onclick="return confirm('¿Seguro que querés eliminar esta carrera?')"
                                        class="bg-red-500 text-white p-2 rounded hover:bg-red-600 transition shadow-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {{/careers}}
                {{^careers}}
                <tr>
                    <td colspan="4" class="py-4 px-4 text-center text-gray-500">
                        No hay carreras registradas.
                    </td>
                </tr>
                {{/careers}}
            </tbody>
        </table>

        <div class="mt-6">
            <a href="/dashboard" class="text-blue-600 hover:underline">← Volver al dashboard</a>
        </div>
    </div>
</body>
</html>
