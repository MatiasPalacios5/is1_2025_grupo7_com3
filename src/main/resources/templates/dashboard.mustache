<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Bienvenido</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-2xl">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Panel de Control</h1>

        {{#username}}
        <p class="text-xl text-center text-gray-700 mb-8">¡Bienvenido, <span class="font-semibold text-blue-600">{{username}}</span>!</p>
        {{/username}}
        {{^username}}
        <p class="text-xl text-center text-gray-700 mb-8">¡Bienvenido!</p>
        {{/username}}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="bg-blue-50 border border-blue-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-blue-700 mb-3">Tu Perfil</h2>
                <p class="text-gray-600 mb-4">Gestiona la información de tu cuenta.</p>
                <a href="/profile" class="inline-block bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition duration-300">Ver Perfil</a>
            </div>
            <div class="bg-green-50 border border-green-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-green-700 mb-3">Configuraciones</h2>
                <p class="text-gray-600 mb-4">Ajusta las preferencias de tu aplicación.</p>
                <a href="/settings" class="inline-block bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 transition duration-300">Configuración</a>
            </div>
            
            <!-- NUEVA TARJETA: Alta de Profesor -->
            <div class="bg-purple-50 border border-purple-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-purple-700 mb-3">Gestión de Profesores</h2>
                <p class="text-gray-600 mb-4">Registrá y administrá los profesores del sistema.</p>
                <a href="/profesor/list"
                   class="inline-block bg-purple-600 text-white py-2 px-4 rounded-md hover:bg-purple-700 transition duration-300">
                    Ver Profesores
                </a>
            </div>

            <!-- NUEVA TARJETA: Gestión de Estudiantes -->
            <div class="bg-blue-50 border border-blue-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-blue-700 mb-3">Gestión de Estudiantes</h2>
                <p class="text-gray-600 mb-4">Registrá y administrá los estudiantes del sistema.</p>
                <a href="/estudiante/list" class="inline-block bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition duration-300">Ver Estudiantes</a>
            </div>

            <!-- NUEVA TARJETA: Gestión de Materias -->
            <div class="bg-green-50 border border-green-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-green-700 mb-3">Gestión de Materias</h2>
                <p class="text-gray-600 mb-4">Registrá y administrá las materias del sistema.</p>
                <a href="/materia/list"
                   class="inline-block bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 transition duration-300">
                    Ver Materias
                </a>
            </div>

            <!-- NUEVA TARJETA: Gestión de Carreras -->
            <div class="bg-indigo-50 border border-indigo-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-indigo-700 mb-3">Gestión de Carreras</h2>
                <p class="text-gray-600 mb-4">Registrá y administrá las carreras del sistema.</p>
                <a href="/carrera/list"
                   class="inline-block bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 transition duration-300">
                    Ver Carreras
                </a>
            </div>

            <!-- NUEVA TARJETA: Periodos Académicos -->
            <div class="bg-orange-50 border border-orange-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-orange-700 mb-3">Periodos Académicos</h2>
                <p class="text-gray-600 mb-4">Gestioná los años y semestres del sistema.</p>
                <a href="/periodo/list"
                   class="inline-block bg-orange-600 text-white py-2 px-4 rounded-md hover:bg-orange-700 transition duration-300">
                    Ver Periodos
                </a>
            </div>

            <!-- NUEVA TARJETA: Asignación Docente -->
            <div class="bg-yellow-50 border border-yellow-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-yellow-700 mb-3">Asignación Docente</h2>
                <p class="text-gray-600 mb-4">Asigná profesores a materias por período académico.</p>
                <a href="/asignacion/list"
                   class="inline-block bg-yellow-600 text-white py-2 px-4 rounded-md hover:bg-yellow-700 transition duration-300">
                    Ver Asignaciones
                </a>
            </div>

            <!-- NUEVA TARJETA: Planes de Estudio -->
            <div class="bg-teal-50 border border-teal-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-teal-700 mb-3">Planes de Estudio</h2>
                <p class="text-gray-600 mb-4">Administrá los planes de estudio por carrera.</p>
                <a href="/plan/list"
                   class="inline-block bg-teal-600 text-white py-2 px-4 rounded-md hover:bg-teal-700 transition duration-300">
                    Ver Planes
                </a>
            </div>
            <!-- NUEVA TARJETA: Exámenes Rendidos -->
            <div class="bg-rose-50 border border-rose-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-rose-700 mb-3">Exámenes Rendidos</h2>
                <p class="text-gray-600 mb-4">Administrá las notas de finales de los estudiantes.</p>
                <a href="/examen/list"
                   class="inline-block bg-rose-600 text-white py-2 px-4 rounded-md hover:bg-rose-700 transition duration-300">
                    Ver Exámenes
                </a>
            </div>
        </div>

        <div class="text-center mt-6">
            <a href="/logout" class="inline-block bg-red-600 text-white py-2 px-6 rounded-md hover:bg-red-700 transition duration-300 text-lg">Cerrar Sesión</a>
        </div>
    </div>
</body>
</html>