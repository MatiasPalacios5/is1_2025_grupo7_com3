<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Registrar Examen Rendido</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Registrar Examen</h1>

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/examen/new" method="post" class="space-y-4">
            
            <div>
                <label for="id_student" class="block text-gray-700 text-sm font-medium mb-1">Estudiante: <span class="text-red-500">*</span></label>
                <select id="id_student" name="id_student" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500">
                    <option value="">Seleccionar estudiante...</option>
                    {{#students}}
                    <option value="{{id}}">{{name}}</option>
                    {{/students}}
                </select>
            </div>

            <div>
                <label for="id_subject" class="block text-gray-700 text-sm font-medium mb-1">Materia: <span class="text-red-500">*</span></label>
                <select id="id_subject" name="id_subject" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500">
                    <option value="">Seleccionar materia...</option>
                    {{#subjects}}
                    <option value="{{id}}">{{nombre}} ({{codigo}})</option>
                    {{/subjects}}
                </select>
            </div>

            <div>
                <label for="fecha" class="block text-gray-700 text-sm font-medium mb-1">Fecha del Examen: <span class="text-red-500">*</span></label>
                <input type="date" id="fecha" name="fecha" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500">
            </div>
            
            <div>
                <label for="nota" class="block text-gray-700 text-sm font-medium mb-1">Nota (1 a 10): <span class="text-red-500">*</span></label>
                <input type="number" id="nota" name="nota" min="1" max="10" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500">
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit" class="flex-1 bg-emerald-600 text-white py-2 px-4 rounded-md hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">
                    Guardar
                </button>
                <a href="/examen/list" class="flex-1 bg-gray-400 text-white py-2 px-4 rounded-md hover:bg-gray-500 text-center">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</body>
</html>
