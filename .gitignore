cat > .gitignore << 'EOF'
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven
target/
dependency-reduced-pom.xml

# Base de datos local
db/dev.db
db/prod.db

# IDEs
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# Virtual machine crash logs
hs_err_pid*
replay_pid*
EOF